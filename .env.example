# The real key is read from the OS environment. Never put it in frontend variables.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Empty uses DEEPSEEK_MODEL. Must support images; called only for opted-in files with images.
DEEPSEEK_VISION_MODEL=
CHAT_MAX_ROUNDS=8
CHAT_TIMEOUT_SECONDS=300
MAX_MULTIMODAL_IMAGES=60
TEXTILE_DATA_DIR=./data
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# CPU ONNX keeps GPU memory free; set CUDAExecutionProvider only with a compatible onnxruntime-gpu installation.
ONNX_PROVIDER=CPUExecutionProvider
# Optional shared model-weight folder; empty uses TEXTILE_DATA_DIR/models.
EMBEDDING_CACHE_DIR=
EMBEDDING_CACHE_VERSION=1

# Single-host ingestion: do not increase workers blindly on an 8GB GPU.
# Set false on the API when running `python -m backend.worker` separately.
INGESTION_ENABLED=true
INGESTION_WORKERS=2
INGESTION_QUEUE_LIMIT=10000
INGESTION_MAX_ATTEMPTS=4
INGESTION_LEASE_SECONDS=90
INGESTION_POLL_SECONDS=0.25
PARSE_TIMEOUT_SECONDS=300
VISION_TIMEOUT_SECONDS=100
VISION_CONCURRENCY=2
VISION_REQUESTS_PER_MINUTE=30
EMBEDDING_BATCH_SIZE=32
VECTOR_WRITE_BATCH_SIZE=256
UPLOAD_CONCURRENCY=4
MINIMUM_FREE_DISK_MB=512
CACHE_MAX_MB=512
CHECKPOINT_RETENTION_HOURS=24
FAILED_CHECKPOINT_RETENTION_HOURS=168
